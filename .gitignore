# Config contains API key and personal settings — do not commit.
# Also ignore the atomic-write temp file and the .bak recovery copy
# (config_paths.save_config).
config.json
config.json.bak
config.json.tmp

# Database files
data/*.db
data/*.db-wal
data/*.db-shm
# The pre-migration backups. Same rule as the database itself, and they were
# missing it: `git add -A` swept 1.5 GB of them into a commit on 5 Sep 2026.
data/*.db.bak-*

# Scratch capture dirs written by the board and traffic readers.
_board/
_traffic/

# Derived: the phrase embeddings are a pure function of the phrase
# list and the model file, rebuilt on demand if absent or stale.
data/ptt_embeddings.npz
data/ptt_embeddings.npz.tmp

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
api_key.txt

# Piper neural TTS voice models (~60 MB each). Not committed: 60 MB of
# binary in git forever costs more than one download command.
#   python -m piper.download_voices en_GB-alan-medium pitcrew/engineer/piper_models
pitcrew/engineer/piper_models/
*.onnx
*.onnx.json

# The rendered phrase pack. Same reasoning as the model above, more so: it is
# ~33 MB of wav, it is reproducible from the manifest and the model, and it is
# replaced wholesale every time the voice or the tuning changes - so committing
# it would put a fresh 33 MB in history for every tweak.
#   python tools/render_voice_pack.py
pitcrew/engineer/voice_pack/

# Data wipe quarantine (2026-08-02) — corrupt event/car/track linkage
_quarantine_*/
.last_quarantine_path

# Pit Crew runtime data - race prep, never committed
data/pitcrew.db
data/pitcrew.db-wal
data/pitcrew.db-shm
exports/
# Raw session captures: ~40 MB a race, and they are the driver's own
# measurement runs, not source.
captures/
# The append-only observation logs: what he reported over the radio
# (race/driver_report.py) and what the HUD was showing when a tyre frame went
# red (race/hud_calibration.py). Both are his own race record, and neither is
# source - `data/` otherwise holds committed reference JSON, so without this
# they are one `git add data/` away from being published.
data/driver_reports.jsonl
data/tyre_hud_calibration.jsonl

data/gt7_sessions.db
*.pyc
# scratch icon crops
_icon_*.png

# Staged for deletion - a Kokoro ONNX model and a whole virtualenv, 533 MB
# across 5,831 files. Ignored rather than committed because git history does
# not shed large blobs without a rewrite, and this is not source.
_to_delete/
# Pasted SimHub forum threads, kept while the wind and shaker work was live.
# Research notes, not repo content.
allissues.txt

# Decoded frames and contact sheets for the gap-font labelling pass. Hundreds
# of 1920x1080 PNGs cut out of a 2.5 GB capture: reproducible from the video
# with `tools/gap_bank.py frames`, and not source. The LABELS the pass produced
# live in that tool, and the bank it builds is committed.
_gapbank/
_glyphwork/
_bench/
